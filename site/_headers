/c/app
  Cache-Control: no-cache, max-age=0, must-revalidate
/c/main
  Cache-Control: no-cache, max-age=0, must-revalidate
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# One block per path (#64): a second /appdata/* block (robots) used to replace this cache rule on Cloudflare Pages.
/appdata/*
