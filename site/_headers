# HTML always revalidates (no-cache): every page, with or without .html, including pretty
# /ad/ and /c/ad/ aerodrome URLs (the shell address bar uses /ad/FAOR, not .html), so a new deploy is seen on the next load.
# Versioned and static assets cache for a year (immutable). Their ?v= is the
# content hash (sha256, first 10 hex) written by tools/vbump.mjs; tests/perf/cache-headers.mjs fails if one is stale
# or if a file under an immutable rule is loaded without ?v=.
# Page rules never overlap asset rules, so Netlify never merges two Cache-Control values.
# Cloudflare Pages: a second block for the SAME path replaces the first block's Cache-Control (checked with
# wrangler pages dev, 11 Nov 2026). So each path has ONE block here, /appdata/* and /c/appdata/* included (#64, MT yes 11 Nov).
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/*.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/index
  Cache-Control: no-cache, max-age=0, must-revalidate
/app
  Cache-Control: no-cache, max-age=0, must-revalidate
/main
  Cache-Control: no-cache, max-age=0, must-revalidate
/calculator
  Cache-Control: no-cache, max-age=0, must-revalidate
/library
  Cache-Control: no-cache, max-age=0, must-revalidate
/logbook
  Cache-Control: no-cache, max-age=0, must-revalidate
/pilot
  Cache-Control: no-cache, max-age=0, must-revalidate
/ops
  Cache-Control: no-cache, max-age=0, must-revalidate
/ops-weather
  Cache-Control: no-cache, max-age=0, must-revalidate
/dashboard
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive
/fact
  Cache-Control: no-cache, max-age=0, must-revalidate
# Pretty aerodrome URLs (12 Nov 2026): without these, /ad/FAOR got Cloudflare's default
# public, max-age=0, must-revalidate (no no-cache, and HTML had no ETag), so a reload of a
# field opened in the shell could keep or re-serve the standalone old page.
/ad/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/c/ad/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/brief
